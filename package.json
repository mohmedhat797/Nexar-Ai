{
  "name": "nexar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @nexar/cli build && pnpm --filter @nexar/desktop build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p apps/desktop/tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "desktop:e2e": "pnpm --filter @nexar/desktop e2e",
    "desktop:package:win": "pnpm --filter @nexar/desktop package:win",
    "cowork:wsl:provision": "node scripts/provision-wsl-cowork-helper.mjs",
    "ci:local:quick": "node scripts/local-ci/runner.mjs --mode=quick",
    "ci:local:full": "node scripts/local-ci/runner.mjs --mode=full",
    "ci:local:report": "node scripts/local-ci/runner.mjs --mode=report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
