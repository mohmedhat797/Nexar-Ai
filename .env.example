# Nexar environment template.
# Never commit real values. Copy this file to `.env` and fill in locally.

# Path to the Nexar config file (optional)
NEXAR_CONFIG_PATH=
# Log level: debug | info | warn | error
NEXAR_LOG_LEVEL=info
# Set to any non-empty value to run live/paid-provider tests (opt-in)
NEXAR_LIVE_TESTS=

# Provider credentials
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
