{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@nexar/integration-*": ["./integrations/*/src/index.ts"],
      "@nexar/cli": ["./apps/cli/src/index.ts"],
      "@nexar/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "integrations/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
