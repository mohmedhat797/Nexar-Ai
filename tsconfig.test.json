{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@nexar/engine-gateway/testing": ["./packages/engine-gateway/src/control-test-kit.ts"],
      "@nexar/integration-*": ["./integrations/*/src/index.ts"],
      "@nexar/cli": ["./apps/cli/src/index.ts"],
      "@nexar/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "integrations/*/src/**/*.ts",
    "apps/desktop/e2e/**/*.ts",
    "apps/desktop/vite.config.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["apps/desktop/src/renderer/**"]
}
